Loop
    Next h

    FindAllMeetingLinks = found
End Function

Private Function ExtractUrlAtHost( _
    ByVal text As String, _
    ByVal hostPos As Long, _
    ByVal host As String) As String

    Dim startPos As Long
    Dim endPos As Long
    Dim ch As String
    Dim url As String
    Dim prefix As String

    startPos = hostPos
    If hostPos > 8 Then
        prefix = LCase$(Mid$(text, hostPos - 8, 8))
        If Right$(prefix, 8) = "https://" Then
            startPos = hostPos - 8
        End If
    End If
    If startPos = hostPos And hostPos > 7 Then
        prefix = LCase$(Mid$(text, hostPos - 7, 7))
        If Right$(prefix, 7) = "http://" Then
            startPos = hostPos - 7
        End If
    End If
    If startPos = hostPos And hostPos > 2 Then
        If Mid$(text, hostPos - 2, 2) = "//" Then
            startPos = hostPos - 2
        End If
    End If

    endPos = hostPos + Len(host)
    Do While endPos <= Len(text)
        ch = Mid$(text, endPos, 1)
        Select Case True
            Case ch >= "A" And ch <= "Z"
            Case ch >= "a" And ch <= "z"
            Case ch >= "0" And ch <= "9"
            Case InStr(":/?#[]@!$&'()*+,;=-._~%", ch) > 0
            Case Else
                Exit Do
        End Select
        endPos = endPos + 1
    Loop

    url = Mid$(text, startPos, endPos - startPos)
    url = TrimTrailingUrlJunk(url)

    If Len(url) > 0 Then
        If LCase$(Left$(url, 7)) <> "http://" And LCase$(Left$(url, 8)) <> "https://" Then
            If Left$(url, 2) = "//" Then
                url = "https:" & url
            Else
                url = "https://" & url
            End If
        End If
    End If

    ExtractUrlAtHost = url
End Function

Private Function TrimTrailingUrlJunk(ByVal url As String) As String
    Dim lastChar As String

    Do While Len(url) > 0
        lastChar = Right$(url, 1)
        Select Case lastChar
            Case ".", ",", ";", "!", "?", ")", "]", "}", """", "'", ">"
                url = Left$(url, Len(url) - 1)
            Case Else
                Exit Do
        End Select
    Loop

    TrimTrailingUrlJunk = url
End Function


' --- Russian UI via ChrW/H hex (encoding-safe after .bas import) ---

Private Function H(ByVal hexUtf16 As String) As String
    Dim i As Long
    Dim s As String
    s = ""
    For i = 1 To Len(hexUtf16) Step 4
        s = s & ChrW(CLng("&H" & Mid$(hexUtf16, i, 4)))
    Next i
    H = s
End Function

